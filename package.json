{
  "name": "exodia-context-scaffolder",
  "version": "3.1.0",
  "private": true,
  "description": "AGENTS.md scaffolder for context engineering. Helper CLIs invoked by the /exodia skill protocol.",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "build": "tsdown",
    "test": "tsdown && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "yaml": "2.6.1"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "husky": "9.1.7",
    "lint-staged": "15.3.0",
    "tsdown": "0.22.0",
    "typescript": "5.7.3",
    "vitest": "2.1.9"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "bash -c 'pnpm build'",
      "bash -c 'git add dist'"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
